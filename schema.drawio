        <!-- Logical link: payments -> orders (order_id) -->
        <mxCell id="log_payment_order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.25;entryX=0;entryY=0.75;strokeColor=#b07d62;strokeWidth=1.2;dashed=1;" edge="1" parent="1" source="tbl_payments" target="tbl_orders">
          <mxGeometry relative="1" as="geometry">
