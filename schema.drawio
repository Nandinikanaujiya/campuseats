        <!-- Logical link: delivery_jobs -> orders (order_id) -->
        <mxCell id="log_delivery_order" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.25;entryX=1;entryY=0.25;strokeColor=#b07d62;strokeWidth=1.2;dashed=1;" edge="1" parent="1" source="tbl_delivery_jobs" target="tbl_orders">
          <mxGeometry relative="1" as="geometry">
